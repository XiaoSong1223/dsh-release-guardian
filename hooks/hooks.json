{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit:*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/scripts/claude-commit-gate.mjs",
            "timeout": 120,
            "statusMessage": "Scanning the commit for release risk"
          }
        ]
      }
    ]
  }
}
