{
  "name": "dsh-release-guardian",
  "version": "0.1.0",
  "description": "Local, deterministic release risk checks for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-release-guardian": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/types/core/index.d.ts",
      "default": "./lib/core/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    ".codex-plugin/",
    ".claude-plugin/",
    "agents/",
    "bin/",
    "hooks/",
    "scripts/claude-commit-gate.mjs",
    "scripts/guardian-cli-path.mjs",
    "skills/",
    "assets/",
    "README.md",
    "README.zh-CN.md",
    "docs/",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:codex",
    "build:codex": "node scripts/build-codex-cli.mjs",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dsh": "node scripts/dsh-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run build && npm test && npm run verify:package && publint && npm run pack:check",
    "verify:package": "node scripts/verify-package.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "guardian:self": "node lib/cli.js check --repo . --format text"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiaoSong1223/dsh-release-guardian.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "release",
    "security",
    "git-diff",
    "quality-gate"
  ],
  "author": "XiaoSong",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "cross-spawn": "7.0.6",
    "minimatch": "^10.0.3",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "^22.18.0",
    "esbuild": "0.28.2",
    "publint": "0.3.23",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
